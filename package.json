{
  "name": "ai-voice-call-center",
  "version": "3.5.0",
  "description": "Enterprise AI Call Center with Vapi, LiveKit, Multi-language Support & Real-time Monitoring",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:azure": "az functionapp publish ai-call-center-sonic",
    "deploy:github": "gh workflow run deploy.yml",
    "test": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "monitor": "tsx src/monitoring/dashboardServer.ts"
  },
  "dependencies": {
    "@vapi-ai/server-sdk": "^1.5.0",
    "livekit-client": "^1.8.0",
    "livekit-server-sdk": "^0.8.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "ws": "^8.14.0",
    "uuid": "^9.0.1",
    "pino": "^8.17.0",
    "pino-http": "^8.6.0",
    "redis": "^4.6.11",
    "mongoose": "^8.0.0",
    "stripe": "^13.11.0",
    "openai": "^4.24.0",
    "google-cloud-speech": "^5.5.0",
    "google-cloud-translate": "^8.0.0",
    "@azure/ai-language-text": "^1.0.0",
    "@azure/storage-blob": "^3.23.0",
    "@azure/functions": "^1.47.0",
    "socket.io": "^4.7.2",
    "bull": "^4.11.4",
    "moment-timezone": "^0.5.45"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}