    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.0",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.5.5",
    "typescript": "^5.1.6",
    "nodemon": "^3.0.1",
    "tsx": "^3.12.7",
    "eslint": "^8.45.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1"
